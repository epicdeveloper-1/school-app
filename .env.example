# Friend (blank) live site sets NEXT_PUBLIC_APP_PROFILE=blank in CI.
# Personal desktop/dev and the CI "personal" Hosting channel: leave unset
# or set NEXT_PUBLIC_APP_PROFILE=personal (defaults to personal).

# Optional for personal builds — enables Google cloud sync from Settings.
# Use the same Firebase web app keys as the friend site. Each Google account
# only sees its own data (users/{uid}/blobs). Rebuild after changing these:
#   npm run build
#   npm run dist
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Blank friend site only (CI / dist:blank). Personal leaves this unset.
# NEXT_PUBLIC_APP_PROFILE=blank
