{
  "appId": "com.epicdeveloper.weeklystrategy.blank",
  "productName": "Weekly Strategy Blank",
  "extraMetadata": {
    "name": "weekly-strategy-blank",
    "productName": "Weekly Strategy Blank"
  },
  "directories": {
    "output": "release-blank",
    "buildResources": "build"
  },
  "icon": "build/icon.ico",
