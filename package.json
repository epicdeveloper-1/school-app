{
  "name": "school-app",
  "version": "0.1.0",
  "private": true,
  "description": "Weekly Strategy — school week planner (web + desktop)",
  "author": "epicdeveloper-1",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 43123 --webpack",
    "build": "next build",
    "start": "npx --yes serve out -l 43123",
    "lint": "eslint",
    "electron": "electron .",
    "electron:dev": "electron . --dev",
    "electron:build": "next build && electron .",
    "dist": "next build && electron-builder"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.44.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.epicdeveloper.weeklystrategy",
    "productName": "Weekly Strategy",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Weekly Strategy"
    }
  }
}
